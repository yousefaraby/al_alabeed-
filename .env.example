# Public address of the site, used for canonical links, sitemap.xml, robots.txt and structured data.
# Set this to the real domain before deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://alabed-digitallock.com

# Optional: ownership codes from Google Search Console and Bing Webmaster Tools
# ("HTML tag" method; paste only the content="..." value). Leave empty until you have them.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
