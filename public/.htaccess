Options -MultiViews -Indexes
DirectoryIndex index.html

RewriteEngine On

# ---------------------------------------------------------------
# 1) 301 redirects for old URLs (previously in next.config.ts)
#    THE_REQUEST checks only match what the visitor actually typed.
#    Destinations end in "/" because the export uses trailingSlash: true.
# ---------------------------------------------------------------

# /index.html -> /   and   /en/index.html -> /en/
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/en/index\.html[\s?] [NC]
RewriteRule ^en/index\.html$ /en/ [R=301,L]

# /product.html?id=xxx -> /product/xxx/  (and /en/...)
RewriteCond %{QUERY_STRING} (?:^|&)id=([a-z0-9]+)(?:&|$)
RewriteRule ^product\.html$ /product/%1/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)id=([a-z0-9]+)(?:&|$)
RewriteRule ^en/product\.html$ /en/product/%1/? [R=301,L]

# /about.html, /shop.html, /faq.html, /contact.html, /offline.html (and /en/...)
RewriteCond %{THE_REQUEST} \s/(en/)?(about|shop|faq|contact|offline)\.html[\s?] [NC]
RewriteRule ^(en/)?(about|shop|faq|contact|offline)\.html$ /$1$2/ [R=301,L]

# ---------------------------------------------------------------
# 2) Pages
#    Next exports every page as <route>/index.html, so Apache's own
#    DirectoryIndex handles them: /en -> /en/ (301) -> en/index.html.
#    No rewrite rules are needed here.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# 3) 404 handling: the site's own 404 page, in the visitor's language
#    (exported from app/(ar)/error-404 and app/en/error-404,
#     which land in error-404/index.html and en/error-404/index.html)
# ---------------------------------------------------------------
ErrorDocument 404 /error-404/index.html
<If "%{REQUEST_URI} =~ m#^/en(/|$)#">
  ErrorDocument 404 /en/error-404/index.html
</If>
